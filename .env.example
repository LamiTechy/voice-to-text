# Neon (serverless Postgres) connection string — required for auth + history + admin
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Secret used to sign JWT session cookies (use a long random string, 32+ chars)
JWT_SECRET=change-me-to-a-long-random-string

# Groq API key for server-side file transcription (whisper-large-v3)
GROQ_API_KEY=

# Optional: self-hosted edge-tts compatible endpoint (see docs/SYSTEM_DESIGN.md)
# e.g. an HTTP bridge that accepts POST { text, voice, rate, pitch } and returns audio bytes
TTS_API_URL=

# Server TTS provider: "google" (free, unofficial) | "edge" (requires TTS_API_URL) | "off"
TTS_PROVIDER=google

# Seeded admin account (used by `npm run db:seed`)
ADMIN_EMAIL=admin@voicebridge.local
ADMIN_PASSWORD=ChangeMe123!

# Public URL of the deployment (used for links / CORS checks)
NEXT_PUBLIC_APP_URL=http://localhost:3000
