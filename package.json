{
  "name": "voicebridge",
  "version": "1.0.0",
  "private": true,
  "description": "VoiceBridge — Text-to-Speech & Speech-to-Text web application",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
